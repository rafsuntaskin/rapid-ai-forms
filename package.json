{
  "name": "rapid-ai-forms",
  "version": "0.1.0",
  "description": "AI-powered form builder for WordPress.",
  "private": true,
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js src",
    "format": "wp-scripts format src",
    "dist": "bash bin/dist.sh",
    "deploy": "bash bin/svn-deploy.sh",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/wp-ai-forms ./vendor/bin/phpunit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report tests/e2e/.report"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@wordpress/env": "^10.39.0",
    "@wordpress/scripts": "^30.0.0"
  }
}

# Files and directories excluded from the wp.org distribution zip.
# Honored by `wp dist-archive`, `10up/action-wordpress-plugin-deploy`, and similar tools.

# Internal docs
docs/
CLAUDE.md

# wp.org assets live in SVN /assets, not in the plugin folder
assets/

# Build/dev scripts
bin/
dist/

# Note: src/ IS shipped in the dist zip so reviewers and users can see the
# un-minified JSX/SCSS source that produced build/. wp.org Guideline 4
# requires source for any compiled/minified assets to be either bundled or
# linked from the readme; we bundle.
.claude/
.poke/
node_modules/
vendor/

# Dev configs we don't ship.
.git/
.gitignore
.distignore
.editorconfig
.eslintrc*
.prettierrc*
.stylelintrc*

# composer + phpcs are dev-only tooling; the shipped plugin doesn't need them.
composer.json
composer.lock
phpcs.xml*
phpunit.xml*
tests/
.wp-env.json
.wp-env.override.json

# NOTE: package.json, package-lock.json, and webpack.config.js ARE included
# in the dist zip so users / reviewers can run `npm install && npm run build`
# to regenerate the minified JS from src/ — satisfies wp.org Guideline 4.

# OS / IDE
.DS_Store
.vscode/
.idea/

# Misc
*.log
*.zip
